+	CLK_CON_DIV_CLK_G3D_BUS,
+	CLK_CON_DIV_CLK_G3D_APB,
+	CLK_ENABLE_CLK_G3D_BUS,
+};
+
+/* List of parent clocks for muxes in CMU_G3D */
