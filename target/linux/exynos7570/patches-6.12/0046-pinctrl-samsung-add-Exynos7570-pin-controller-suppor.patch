 };
 
+/* pin banks of exynos7570 pin-controller 0 (ALIVE) */
+static const struct samsung_pin_bank_data exynos7570_pin_banks0[] __initconst = {
+	EXYNOS7870_PIN_BANK_EINTN(7, 0x000, "etc0"),
+	EXYNOS7870_PIN_BANK_EINTN(3, 0x020, "etc1"),
+	EXYNOS7870_PIN_BANK_EINTW(8, 0x040, "gpa0", 0x00),
+	EXYNOS7870_PIN_BANK_EINTW(8, 0x060, "gpa1", 0x04),
+	EXYNOS7870_PIN_BANK_EINTW(8, 0x080, "gpa2", 0x08),
+	EXYNOS7870_PIN_BANK_EINTN(1, 0x0a0, "gpq0"),
+};
+
+/* pin banks of exynos7570 pin-controller 1 (DISPAUD) */
+static const struct samsung_pin_bank_data exynos7570_pin_banks1[] __initconst = {
+	EXYNOS8895_PIN_BANK_EINTG(7, 0x000, "gpz1", 0x00),
