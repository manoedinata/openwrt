+	EXYNOS8895_PIN_BANK_EINTG(1, 0x000, "gpm0", 0x00),
+};
+
+/* pin banks of exynos7570 pin-controller 5 (NFC) */
+static const struct samsung_pin_bank_data exynos7570_pin_banks5[] __initconst = {
+	EXYNOS8895_PIN_BANK_EINTG(4, 0x000, "gpc2", 0x00),
