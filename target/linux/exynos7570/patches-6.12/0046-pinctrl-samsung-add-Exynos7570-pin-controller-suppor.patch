+	EXYNOS8895_PIN_BANK_EINTG(7, 0x060, "gpd1", 0x0c),
+	EXYNOS8895_PIN_BANK_EINTG(3, 0x080, "gpe0", 0x10),
+	EXYNOS8895_PIN_BANK_EINTG(4, 0x0a0, "gpf0", 0x14),
+	EXYNOS8895_PIN_BANK_EINTG(2, 0x0c0, "gpf1", 0x18),
