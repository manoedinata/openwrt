From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hendra Manudinata <manoedinata@gmail.com>
Date: Sat, 24 Oct 2026 00:11:04 +0700
Subject: [PATCH 089/106] misc: modem_v1: build in-tree
 (CONFIG_SAMSUNG_MODEM_V1)

Kconfig entry and drivers/misc hooks; tristate, modem_if.ko as a
module. The include paths use $(src), which is absolute in this tree.

(cherry picked from commit c3b081d2331a15573baf6f0070728249d7423b00)
---
 drivers/misc/Kconfig          |  1 +
 drivers/misc/Makefile         |  1 +
 drivers/misc/modem_v1/Kbuild  |  2 +-
 drivers/misc/modem_v1/Kconfig | 17 +++++++++++++++++
 4 files changed, 20 insertions(+), 1 deletion(-)
 create mode 100644 drivers/misc/modem_v1/Kconfig

diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
index 3fe7e2a9b..2d4a1bf18 100644
--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -628,4 +628,5 @@ source "drivers/misc/uacce/Kconfig"
 source "drivers/misc/pvpanic/Kconfig"
 source "drivers/misc/mchp_pci1xxxx/Kconfig"
 source "drivers/misc/keba/Kconfig"
+source "drivers/misc/modem_v1/Kconfig"
 endmenu
diff --git a/drivers/misc/Makefile b/drivers/misc/Makefile
index a9f94525e..dd553a53c 100644
--- a/drivers/misc/Makefile
+++ b/drivers/misc/Makefile
@@ -72,3 +72,4 @@ obj-$(CONFIG_TPS6594_PFSM)	+= tps6594-pfsm.o
 obj-$(CONFIG_NSM)		+= nsm.o
 obj-$(CONFIG_MARVELL_CN10K_DPI)	+= mrvl_cn10k_dpi.o
 obj-y				+= keba/
+obj-$(CONFIG_SAMSUNG_MODEM_V1)	+= modem_v1/
diff --git a/drivers/misc/modem_v1/Kbuild b/drivers/misc/modem_v1/Kbuild
index 25539ed13..e0cf6eeea 100644
--- a/drivers/misc/modem_v1/Kbuild
+++ b/drivers/misc/modem_v1/Kbuild
@@ -1,6 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0
 # Samsung Shannon modem interface (downstream modem_v1 + mcu_ipc + shm_ipc), Exynos7570
-obj-m += modem_if.o
+obj-$(CONFIG_SAMSUNG_MODEM_V1) += modem_if.o
 modem_if-y := modem_main.o modem_variation.o modem_io_device.o modem_utils.o \
 	      link_device_shmem.o link_device_memory_snapshot.o \
 	      link_device_memory_flow_control.o link_device_memory_debug.o \
diff --git a/drivers/misc/modem_v1/Kconfig b/drivers/misc/modem_v1/Kconfig
new file mode 100644
index 000000000..e43b22b39
--- /dev/null
+++ b/drivers/misc/modem_v1/Kconfig
@@ -0,0 +1,17 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config SAMSUNG_MODEM_V1
+	tristate "Samsung Shannon modem interface (downstream modem_v1)"
+	depends on ARM64 && OF && HAVE_ARM_SMCCC
+	depends on ARCH_EXYNOS || COMPILE_TEST
+	select MFD_SYSCON
+	help
+	  The modem interface of Samsung's downstream kernels for the
+	  Exynos7570's Shannon modem (SS305AP) over shared memory, as on the
+	  Galaxy J4: the CP mailbox (mcu_ipc), the shared memory layout
+	  (shm_ipc), the secure-boot CP control and the SIPC5 link with its
+	  io devices (/dev/umts_boot0, umts_ipc0/1, umts_rfs0, rmnet0-7).
+	  Userspace boots and drives the modem with libsamsung-ipc
+	  (samsungipcd).
+
+	  To compile this as a module, choose M here: the module will be
+	  called modem_if.
