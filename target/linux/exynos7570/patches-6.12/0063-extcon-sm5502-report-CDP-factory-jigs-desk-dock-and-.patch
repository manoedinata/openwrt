From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hendra Manudinata <manoedinata@gmail.com>
Date: Sun, 18 Oct 2026 13:12:24 +0700
Subject: [PATCH 63/97] extcon: sm5502: report CDP, factory jigs, desk dock and
 type 2 chargers

The ADC values and device types are the ones of the J4's cable table. The
cables are now a table: what each reports and how the D+/D- and VBUS switches
are set. The charger driver gets the current for the new cables.

Signed-off-by: Hendra Manudinata <manoedinata@gmail.com>
(cherry picked from commit 50da687cbd3a8e8ce70362288441614dc020f27e)
---
 drivers/extcon/extcon-sm5502.c         | 87 +++++++++++++++++---------
 drivers/power/supply/s2mpu06_charger.c | 19 +++++-
 2 files changed, 74 insertions(+), 32 deletions(-)

diff --git a/drivers/extcon/extcon-sm5502.c b/drivers/extcon/extcon-sm5502.c
index c8c4b9ef7..8de9322d5 100644
--- a/drivers/extcon/extcon-sm5502.c
+++ b/drivers/extcon/extcon-sm5502.c
@@ -131,6 +131,9 @@ static const unsigned int sm5502_extcon_cable[] = {
 	EXTCON_USB_HOST,
 	EXTCON_CHG_USB_SDP,
 	EXTCON_CHG_USB_DCP,
+	EXTCON_CHG_USB_CDP,
+	EXTCON_JIG,
+	EXTCON_DOCK,
 	EXTCON_NONE,
 };
 
@@ -182,6 +185,7 @@ enum sm5502_muic_acc_type {
 	SM5502_MUIC_ADC_OPEN_USB = 0x5f,		/* |      010|11111| */
 	SM5502_MUIC_ADC_OPEN_TA = 0xdf,			/* |      110|11111| */
 	SM5502_MUIC_ADC_OPEN_USB_OTG = 0xff,		/* |      111|11111| */
+	SM5502_MUIC_ADC_OPEN_CDP = 0x3f,		/* |      001|11111| */
 };
 
 /* List of supported interrupt for SM5502 */
@@ -450,6 +454,9 @@ static unsigned int sm5502_muic_get_cable_type(struct sm5502_muic_info *info)
 		case SM5502_REG_DEV_TYPE1_DEDICATED_CHG_MASK:
 			cable_type = SM5502_MUIC_ADC_OPEN_TA;
 			break;
+		case SM5502_REG_DEV_TYPE1_USB_CHG_MASK:
+			cable_type = SM5502_MUIC_ADC_OPEN_CDP;
+			break;
 		default:
 			dev_dbg(info->dev,
 				"cannot identify the cable type: adc(0x%x)\n",
@@ -466,15 +473,51 @@ static unsigned int sm5502_muic_get_cable_type(struct sm5502_muic_info *info)
 	return cable_type;
 }
 
+/* What each recognised cable reports to the consumers and how the switches are set for it */
+struct sm5502_cable {
+	unsigned int type;
+	unsigned int ids[3];	/* EXTCON_NONE terminates */
+	unsigned int con_sw;
+	unsigned int vbus_sw;
+};
+
+static const struct sm5502_cable sm5502_cables[] = {
+	/* a PC port: data to the AP, and the charger limited to 500 mA */
+	{ SM5502_MUIC_ADC_OPEN_USB, { EXTCON_USB, EXTCON_CHG_USB_SDP },
+	  DM_DP_SWITCH_USB, VBUSIN_SWITCH_VBUSOUT_WITH_USB },
+	/* a wall charger, also the 442k type 2 charger */
+	{ SM5502_MUIC_ADC_OPEN_TA, { EXTCON_CHG_USB_DCP },
+	  DM_DP_SWITCH_OPEN, VBUSIN_SWITCH_VBUSOUT },
+	{ SM5502_MUIC_ADC_TYPE2_CHARGER, { EXTCON_CHG_USB_DCP },
+	  DM_DP_SWITCH_OPEN, VBUSIN_SWITCH_VBUSOUT },
+	/* a charging downstream port: data as well as more current */
+	{ SM5502_MUIC_ADC_OPEN_CDP, { EXTCON_USB, EXTCON_CHG_USB_CDP },
+	  DM_DP_SWITCH_USB, VBUSIN_SWITCH_VBUSOUT_WITH_USB },
+	{ SM5502_MUIC_ADC_GROUND_USB_OTG, { EXTCON_USB_HOST },
+	  DM_DP_SWITCH_USB, VBUSIN_SWITCH_OPEN },
+	{ SM5502_MUIC_ADC_OPEN_USB_OTG, { EXTCON_USB_HOST },
+	  DM_DP_SWITCH_USB, VBUSIN_SWITCH_OPEN },
+	/* factory jigs: the USB ones give data, the UART ones route D+/D- to the AP's UART */
+	{ SM5502_MUIC_ADC_FACTORY_MODE_BOOT_OFF_USB, { EXTCON_JIG, EXTCON_USB, EXTCON_CHG_USB_SDP },
+	  DM_DP_SWITCH_USB, VBUSIN_SWITCH_VBUSOUT_WITH_USB },
+	{ SM5502_MUIC_ADC_FACTORY_MODE_BOOT_ON_USB, { EXTCON_JIG, EXTCON_USB, EXTCON_CHG_USB_SDP },
+	  DM_DP_SWITCH_USB, VBUSIN_SWITCH_VBUSOUT_WITH_USB },
+	{ SM5502_MUIC_ADC_FACTORY_MODE_BOOT_OFF_UART, { EXTCON_JIG },
+	  DM_DP_SWITCH_UART, VBUSIN_SWITCH_VBUSOUT },
+	{ SM5502_MUIC_ADC_FACTORY_MODE_BOOT_ON_UART, { EXTCON_JIG },
+	  DM_DP_SWITCH_UART, VBUSIN_SWITCH_VBUSOUT },
+	/* the desk dock: audio/video cable, charged through its VBUS */
+	{ SM5502_MUIC_ADC_AUDIO_VIDEO_CABLE, { EXTCON_DOCK },
+	  DM_DP_SWITCH_OPEN, VBUSIN_SWITCH_VBUSOUT },
+};
+
 static int sm5502_muic_cable_handler(struct sm5502_muic_info *info,
 				     bool attached)
 {
 	static unsigned int prev_cable_type = SM5502_MUIC_ADC_GROUND;
+	const struct sm5502_cable *cable = NULL;
 	unsigned int cable_type = SM5502_MUIC_ADC_GROUND;
-	unsigned int con_sw = DM_DP_SWITCH_OPEN;
-	unsigned int vbus_sw = VBUSIN_SWITCH_OPEN;
-	unsigned int id;
-	int ret;
+	int i, ret;
 
 	/* Get the type of attached or detached cable */
 	if (attached)
@@ -483,39 +526,25 @@ static int sm5502_muic_cable_handler(struct sm5502_muic_info *info,
 		cable_type = prev_cable_type;
 	prev_cable_type = cable_type;
 
-	switch (cable_type) {
-	case SM5502_MUIC_ADC_OPEN_USB:
-		id	= EXTCON_USB;
-		con_sw	= DM_DP_SWITCH_USB;
-		vbus_sw	= VBUSIN_SWITCH_VBUSOUT_WITH_USB;
-		break;
-	case SM5502_MUIC_ADC_OPEN_TA:
-		id	= EXTCON_CHG_USB_DCP;
-		con_sw	= DM_DP_SWITCH_OPEN;
-		vbus_sw	= VBUSIN_SWITCH_VBUSOUT;
-		break;
-	case SM5502_MUIC_ADC_GROUND_USB_OTG:
-	case SM5502_MUIC_ADC_OPEN_USB_OTG:
-		id	= EXTCON_USB_HOST;
-		con_sw	= DM_DP_SWITCH_USB;
-		vbus_sw	= VBUSIN_SWITCH_OPEN;
-		break;
-	default:
-		dev_dbg(info->dev,
-			"cannot handle this cable_type (0x%x)\n", cable_type);
+	for (i = 0; i < ARRAY_SIZE(sm5502_cables); i++) {
+		if (sm5502_cables[i].type == cable_type) {
+			cable = &sm5502_cables[i];
+			break;
+		}
+	}
+	if (!cable) {
+		dev_dbg(info->dev, "cannot handle this cable_type (0x%x)\n", cable_type);
 		return 0;
 	}
 
 	/* Change internal hardware path(DM_CON/DP_CON, VBUSIN) */
-	ret = sm5502_muic_set_path(info, con_sw, vbus_sw, attached);
+	ret = sm5502_muic_set_path(info, cable->con_sw, cable->vbus_sw, attached);
 	if (ret < 0)
 		return ret;
 
 	/* Change the state of external accessory */
-	extcon_set_state_sync(info->edev, id, attached);
-	if (id == EXTCON_USB)
-		extcon_set_state_sync(info->edev, EXTCON_CHG_USB_SDP,
-					attached);
+	for (i = 0; i < ARRAY_SIZE(cable->ids) && cable->ids[i]; i++)
+		extcon_set_state_sync(info->edev, cable->ids[i], attached);
 
 	return 0;
 }
diff --git a/drivers/power/supply/s2mpu06_charger.c b/drivers/power/supply/s2mpu06_charger.c
index daa53f6ad..682da1d76 100644
--- a/drivers/power/supply/s2mpu06_charger.c
+++ b/drivers/power/supply/s2mpu06_charger.c
@@ -99,6 +99,8 @@ enum s2mpu06_temp_state {
 #define S2MPU06_USB_ICHG_UA		500000
 #define S2MPU06_DCP_IIN_UA		1000000
 #define S2MPU06_DCP_ICHG_UA		1200000
+#define S2MPU06_CDP_IIN_UA		1500000
+#define S2MPU06_CDP_ICHG_UA		1500000
 
 struct s2mpu06_charger {
 	struct device *dev;
@@ -521,7 +523,14 @@ static void s2mpu06_charger_cable_work(struct work_struct *work)
 	struct s2mpu06_charger *chg = container_of(work, struct s2mpu06_charger, cable_work);
 	int iin = S2MPU06_USB_IIN_UA, ichg = S2MPU06_USB_ICHG_UA;
 
-	if (extcon_get_state(chg->edev, EXTCON_CHG_USB_DCP) > 0) {
+	if (extcon_get_state(chg->edev, EXTCON_CHG_USB_CDP) > 0) {
+		iin = S2MPU06_CDP_IIN_UA;
+		ichg = S2MPU06_CDP_ICHG_UA;
+	} else if (extcon_get_state(chg->edev, EXTCON_CHG_USB_DCP) > 0 ||
+		   ((extcon_get_state(chg->edev, EXTCON_JIG) > 0 ||
+		     extcon_get_state(chg->edev, EXTCON_DOCK) > 0) &&
+		    extcon_get_state(chg->edev, EXTCON_CHG_USB_SDP) <= 0)) {
+		/* dedicated chargers, the UART jigs and the dock supply like a wall charger */
 		iin = S2MPU06_DCP_IIN_UA;
 		ichg = S2MPU06_DCP_ICHG_UA;
 	}
@@ -545,6 +554,10 @@ static int s2mpu06_charger_cable_event(struct notifier_block *nb, unsigned long
 	return NOTIFY_OK;
 }
 
+static const unsigned int s2mpu06_charger_cables[] = {
+	EXTCON_CHG_USB_SDP, EXTCON_CHG_USB_DCP, EXTCON_CHG_USB_CDP, EXTCON_JIG, EXTCON_DOCK,
+};
+
 static void s2mpu06_charger_cancel_cable(void *data)
 {
 	cancel_work_sync(data);
@@ -619,9 +632,9 @@ static int s2mpu06_charger_probe(struct platform_device *pdev)
 			return ret;
 
 		chg->cable_nb.notifier_call = s2mpu06_charger_cable_event;
-		for (i = 0; i < 2; i++) {
+		for (i = 0; i < ARRAY_SIZE(s2mpu06_charger_cables); i++) {
 			ret = devm_extcon_register_notifier(dev, chg->edev,
-							    i ? EXTCON_CHG_USB_DCP : EXTCON_CHG_USB_SDP,
+							    s2mpu06_charger_cables[i],
 							    &chg->cable_nb);
 			if (ret)
 				return dev_err_probe(dev, ret, "cannot watch the cable\n");
