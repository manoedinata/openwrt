From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hendra Manudinata <manoedinata@gmail.com>
Date: Sun, 18 Oct 2026 11:56:49 +0700
Subject: [PATCH 57/97] iio: adc: exynos_adc: add Exynos7570 support

Signed-off-by: Hendra Manudinata <manoedinata@gmail.com>
(cherry picked from commit a3937cc4859e0f7be100940546c788a2fc425b42)
---
 .../bindings/iio/adc/samsung,exynos-adc.yaml  | 13 ++++++-
 drivers/iio/adc/exynos_adc.c                  | 34 +++++++++++++++++++
 2 files changed, 46 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/iio/adc/samsung,exynos-adc.yaml b/Documentation/devicetree/bindings/iio/adc/samsung,exynos-adc.yaml
index 4e40f6bed..a9892c480 100644
--- a/Documentation/devicetree/bindings/iio/adc/samsung,exynos-adc.yaml
+++ b/Documentation/devicetree/bindings/iio/adc/samsung,exynos-adc.yaml
@@ -18,6 +18,7 @@ properties:
           - samsung,exynos3250-adc
           - samsung,exynos4212-adc                # Exynos4212 and Exynos4412
           - samsung,exynos7-adc
+          - samsung,exynos7570-adc
           - samsung,s3c2410-adc
           - samsung,s3c2416-adc
           - samsung,s3c2440-adc
@@ -74,7 +75,6 @@ required:
   - clock-names
   - interrupts
   - "#io-channel-cells"
-  - vdd-supply
 
 additionalProperties:
   type: object
@@ -93,12 +93,23 @@ allOf:
       required:
         - samsung,syscon-phandle
 
+  - if:
+      not:
+        properties:
+          compatible:
+            contains:
+              const: samsung,exynos7570-adc
+    then:
+      required:
+        - vdd-supply
+
   - if:
       properties:
         compatible:
           contains:
             enum:
               - samsung,exynos3250-adc
+              - samsung,exynos7570-adc
     then:
       properties:
         clocks:
diff --git a/drivers/iio/adc/exynos_adc.c b/drivers/iio/adc/exynos_adc.c
index b97d46c94..313b260cc 100644
--- a/drivers/iio/adc/exynos_adc.c
+++ b/drivers/iio/adc/exynos_adc.c
@@ -38,6 +38,7 @@
 #define ADC_V1_TSC(x)		((x) + 0x04)
 #define ADC_V1_DLY(x)		((x) + 0x08)
 #define ADC_V1_DATX(x)		((x) + 0x0C)
+#define ADC_V3_DAT(x)		((x) + 0x08)
 #define ADC_V1_DATY(x)		((x) + 0x10)
 #define ADC_V1_UPDN(x)		((x) + 0x14)
 #define ADC_V1_INTCLR(x)	((x) + 0x18)
@@ -92,6 +93,7 @@
 
 /* Bit definitions for ADC_V2 */
 #define ADC_V2_CON1_SOFT_RESET	(1u << 2)
+#define ADC_V2_CON1_SOFT_NON_RESET	(1u << 1)
 
 #define ADC_V2_CON2_OSEL	(1u << 10)
 #define ADC_V2_CON2_ESEL	(1u << 9)
@@ -158,6 +160,7 @@ struct exynos_adc_data {
 	bool needs_sclk;
 	bool needs_adc_phy;
 	int phy_offset;
+	bool dat_at_0x08;
 	u32 mask;
 
 	void (*init_hw)(struct exynos_adc *info);
@@ -484,6 +487,32 @@ static const struct exynos_adc_data exynos7_adc_data = {
 	.start_conv	= exynos_adc_v2_start_conv,
 };
 
+static void exynos_adc_exynos7570_init_hw(struct exynos_adc *info)
+{
+	u32 con2;
+
+	writel(ADC_V2_CON1_SOFT_RESET, ADC_V2_CON1(info->regs));
+	writel(ADC_V2_CON1_SOFT_NON_RESET, ADC_V2_CON1(info->regs));
+
+	con2 = ADC_V2_CON2_C_TIME(6);
+	writel(con2, ADC_V2_CON2(info->regs));
+
+	/* Enable interrupts */
+	writel(1, ADC_V2_INT_EN(info->regs));
+}
+
+static const struct exynos_adc_data exynos7570_adc_data = {
+	.num_channels	= MAX_ADC_V1_CHANNELS,
+	.mask		= ADC_DATX_MASK, /* 12 bit ADC resolution */
+	.needs_sclk	= true,
+	.dat_at_0x08	= true,
+
+	.init_hw	= exynos_adc_exynos7570_init_hw,
+	.exit_hw	= exynos_adc_v2_exit_hw,
+	.clear_irq	= exynos_adc_v2_clear_irq,
+	.start_conv	= exynos_adc_v2_start_conv,
+};
+
 static const struct of_device_id exynos_adc_match[] = {
 	{
 		.compatible = "samsung,s3c2410-adc",
@@ -518,6 +547,9 @@ static const struct of_device_id exynos_adc_match[] = {
 	}, {
 		.compatible = "samsung,exynos7-adc",
 		.data = &exynos7_adc_data,
+	}, {
+		.compatible = "samsung,exynos7570-adc",
+		.data = &exynos7570_adc_data,
 	},
 	{ }
 };
@@ -626,6 +658,8 @@ static irqreturn_t exynos_adc_isr(int irq, void *dev_id)
 		info->ts_x = readl(ADC_V1_DATX(info->regs));
 		info->ts_y = readl(ADC_V1_DATY(info->regs));
 		writel(ADC_TSC_WAIT4INT | ADC_S3C2443_TSC_UD_SEN, ADC_V1_TSC(info->regs));
+	} else if (info->data->dat_at_0x08) {
+		info->value = readl(ADC_V3_DAT(info->regs)) & mask;
 	} else {
 		info->value = readl(ADC_V1_DATX(info->regs)) & mask;
 	}
