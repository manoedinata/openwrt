From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hendra Manudinata <manoedinata@gmail.com>
Date: Sun, 18 Oct 2026 14:13:46 +0700
Subject: [PATCH 64/92] mmc: dw_mmc-exynos: HS400 through the ultra low power
 route

The Exynos7570 runs HS400 with the card clock equal to the CIU clock, divided
like in the other modes, and with the controller's ULP bits set. HS400 also
needs the timer for the write CRC status and a FIFO clock delay. The route is
chosen by samsung,hs400-ulp-mode; the timer values, the timing and the
read strobe delay come from the device tree. In this route the HS200 tuning
runs in the plain HS200 setup, and only the HS400 switch uses the tuned
sample with the HS400 timing.

Signed-off-by: Hendra Manudinata <manoedinata@gmail.com>
(cherry picked from commit 36b411056e9db85fb4e0897f8df109a20f001228)
---
 .../bindings/mmc/samsung,exynos-dw-mshc.yaml  | 22 +++++++++
 drivers/mmc/host/dw_mmc-exynos.c              | 45 +++++++++++++++++--
 drivers/mmc/host/dw_mmc-exynos.h              |  8 ++++
 3 files changed, 72 insertions(+), 3 deletions(-)

diff --git a/Documentation/devicetree/bindings/mmc/samsung,exynos-dw-mshc.yaml b/Documentation/devicetree/bindings/mmc/samsung,exynos-dw-mshc.yaml
index e0160415a..a683d7504 100644
--- a/Documentation/devicetree/bindings/mmc/samsung,exynos-dw-mshc.yaml
+++ b/Documentation/devicetree/bindings/mmc/samsung,exynos-dw-mshc.yaml
@@ -111,6 +111,28 @@ properties:
       phase shift value in receive mode for single data rate mode operation.
       See also samsung,dw-mshc-hs400-timing property.
 
+  samsung,hs400-ulp-mode:
+    type: boolean
+    description:
+      Run HS400 in the ultra low power mode of the controller. The card clock
+      stays the CIU clock (divided like in the other modes) and the timing of
+      samsung,dw-mshc-hs400-timing applies to that divider, instead of the
+      fixed divider and doubled CIU clock of the regular route.
+
+  samsung,dw-mshc-txdt-crc-timer-fastlimit:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 255
+    description:
+      Limit of the timer that waits for the CRC status of write data in HS400
+      with samsung,hs400-ulp-mode.
+
+  samsung,dw-mshc-txdt-crc-timer-initval:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 255
+    description:
+      Initial value of the timer that waits for the CRC status of write data
+      in HS400 with samsung,hs400-ulp-mode.
+
   samsung,read-strobe-delay:
     $ref: /schemas/types.yaml#/definitions/uint32
     description:
diff --git a/drivers/mmc/host/dw_mmc-exynos.c b/drivers/mmc/host/dw_mmc-exynos.c
index 89682f10e..d269f55b2 100644
--- a/drivers/mmc/host/dw_mmc-exynos.c
+++ b/drivers/mmc/host/dw_mmc-exynos.c
@@ -42,6 +42,10 @@ struct dw_mci_exynos_priv_data {
 	u32				tuned_sample;
 	u32				cur_speed;
 	u32				dqs_delay;
+	bool				hs400_ulp;
+	u32				ulp_default;	/* the ULP bits as found at probe */
+	u32				txdt_crc_fastlimit;
+	u32				txdt_crc_initval;
 	u32				saved_dqs_en;
 	u32				saved_strobe_ctrl;
 };
@@ -127,6 +131,12 @@ static int dw_mci_exynos_priv_init(struct dw_mci *host)
 
 	dw_mci_exynos_config_smu(host);
 
+	if (priv->ctrl_type == DW_MCI_TYPE_EXYNOS7 ||
+	    priv->ctrl_type == DW_MCI_TYPE_EXYNOS7_SMU ||
+	    priv->ctrl_type == DW_MCI_TYPE_EXYNOS7870 ||
+	    priv->ctrl_type == DW_MCI_TYPE_EXYNOS7870_SMU)
+		priv->ulp_default = mci_readl(host, CLKSEL64) & SDMMC_CLKSEL_ULP;
+
 	if (priv->ctrl_type >= DW_MCI_TYPE_EXYNOS5420) {
 		priv->saved_strobe_ctrl = mci_readl(host, HS400_DLINE_CTRL);
 		priv->saved_dqs_en = mci_readl(host, HS400_DQS_EN);
@@ -167,7 +177,9 @@ static void dw_mci_exynos_set_clksel_timing(struct dw_mci *host, u32 timing)
 	else
 		clksel = mci_readl(host, CLKSEL);
 
-	clksel = (clksel & ~SDMMC_CLKSEL_TIMING_MASK) | timing;
+	/* only HS400 changes the ULP bits, every other timing keeps them as found */
+	clksel = (clksel & ~(SDMMC_CLKSEL_TIMING_MASK | SDMMC_CLKSEL_ULP)) |
+		 priv->ulp_default | timing;
 
 	if (priv->ctrl_type == DW_MCI_TYPE_EXYNOS7 ||
 		priv->ctrl_type == DW_MCI_TYPE_EXYNOS7_SMU ||
@@ -290,6 +302,13 @@ static void dw_mci_exynos_config_hs400(struct dw_mci *host, u32 timing)
 	if (timing == MMC_TIMING_MMC_HS400) {
 		dqs |= DATA_STROBE_EN;
 		strobe = DQS_CTRL_RD_DELAY(strobe, priv->dqs_delay);
+		if (priv->hs400_ulp) {
+			/* when the write data CRC status is expected, and the FIFO clock delay */
+			dqs = (dqs & ~DQS_EN_TXDT_CRC_TIMER_MASK) |
+			      DQS_EN_TXDT_CRC_TIMER(priv->txdt_crc_fastlimit,
+						    priv->txdt_crc_initval);
+			strobe = DQS_CTRL_FIFO_CLK_DELAY(strobe, 2);
+		}
 	} else if (timing == MMC_TIMING_UHS_SDR104) {
 		dqs &= 0xffffff00;
 	} else {
@@ -343,7 +362,10 @@ static void dw_mci_exynos_set_ios(struct dw_mci *host, struct mmc_ios *ios)
 		/* Update tuned sample timing */
 		clksel = SDMMC_CLKSEL_UP_SAMPLE(
 				priv->hs400_timing, priv->tuned_sample);
-		wanted <<= 1;
+		if (priv->hs400_ulp)
+			clksel |= SDMMC_CLKSEL_ULP;	/* the card clock stays the CIU clock */
+		else
+			wanted <<= 1;
 		break;
 	case MMC_TIMING_MMC_DDR52:
 		clksel = priv->ddr_timing;
@@ -422,8 +444,18 @@ static int dw_mci_exynos_parse_dt(struct dw_mci *host)
 		dev_dbg(host->dev,
 			"read-strobe-delay is not found, assuming usage of default value\n");
 
+	/*
+	 * The ultra low power route runs HS400 off the CIU clock divided like in the
+	 * other modes, instead of the fixed divider of the regular route.
+	 */
+	priv->hs400_ulp = of_property_read_bool(np, "samsung,hs400-ulp-mode");
+	of_property_read_u32(np, "samsung,dw-mshc-txdt-crc-timer-fastlimit",
+			     &priv->txdt_crc_fastlimit);
+	of_property_read_u32(np, "samsung,dw-mshc-txdt-crc-timer-initval",
+			     &priv->txdt_crc_initval);
+
 	priv->hs400_timing = SDMMC_CLKSEL_TIMING(timing[0], timing[1],
-						HS400_FIXED_CIU_CLK_DIV);
+						priv->hs400_ulp ? div : HS400_FIXED_CIU_CLK_DIV);
 	host->priv = priv;
 	return 0;
 }
@@ -572,6 +604,13 @@ static int dw_mci_exynos_prepare_hs400_tuning(struct dw_mci *host,
 {
 	struct dw_mci_exynos_priv_data *priv = host->priv;
 
+	/*
+	 * The ultra low power route is tuned in the plain HS200 setup and only
+	 * switched to its own timing for HS400, with the tuned sample.
+	 */
+	if (priv->hs400_ulp)
+		return 0;
+
 	dw_mci_exynos_set_clksel_timing(host, priv->hs400_timing);
 	dw_mci_exynos_adjust_clock(host, (ios->clock) << 1);
 
diff --git a/drivers/mmc/host/dw_mmc-exynos.h b/drivers/mmc/host/dw_mmc-exynos.h
index 0280d394a..0d4599738 100644
--- a/drivers/mmc/host/dw_mmc-exynos.h
+++ b/drivers/mmc/host/dw_mmc-exynos.h
@@ -34,9 +34,17 @@
 #define DATA_STROBE_EN			BIT(0)
 #define AXI_NON_BLOCKING_WR	BIT(7)
 
+/* DQS_EN register defines */
+#define DQS_EN_TXDT_CRC_TIMER(fast, init)	((((fast) & 0xFF) << 16) | (((init) & 0xFF) << 8))
+#define DQS_EN_TXDT_CRC_TIMER_MASK		DQS_EN_TXDT_CRC_TIMER(0xFF, 0xFF)
+
 /* DLINE_CTRL register defines */
 #define DQS_CTRL_RD_DELAY(x, y)		(((x) & ~0x3FF) | ((y) & 0x3FF))
 #define DQS_CTRL_GET_RD_DELAY(x)	((x) & 0x3FF)
+#define DQS_CTRL_FIFO_CLK_DELAY(x, y)	(((x) & ~(0x3 << 16)) | (((y) & 0x3) << 16))
+
+/* CLKSEL: ultra low power mode, used with HS400 on Exynos7570 */
+#define SDMMC_CLKSEL_ULP		(BIT(30) | BIT(19))
 
 /* Protector Register */
 #define SDMMC_EMMCP_BASE	0x1000
