 arch/arm64/boot/dts/exynos/Makefile           |   1 +
 .../boot/dts/exynos/exynos7570-j4lte.dts      |  90 +++++++++++++
 arch/arm64/boot/dts/exynos/exynos7570.dtsi    | 127 ++++++++++++++++++
 4 files changed, 224 insertions(+)
