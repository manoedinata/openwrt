From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hendra Manudinata <manoedinata@gmail.com>
Date: Fri, 23 Oct 2026 23:11:02 +0700
Subject: [PATCH 087/105] arm64: dts: exynos7570: add the CP mailbox; j4lte:
 modem interface

mailbox@10500000 (SPI 369) for the AP <-> CP mailbox. On the J4: the
shm_ipc node splitting the modem carveout into the CP boot region and
the IPC region, and mif_pdata as in the downstream
modem-ss305ap-pdata.dtsi plus the board's reg (CP main image offset)
and the gpa2-6 line handed to the CP.

(cherry picked from commit 3e1736be2f39411b208aa2a0ac4e7d52d99e007e)
---
 .../boot/dts/exynos/exynos7570-j4lte.dts      | 266 +++++++++++++++++-
 arch/arm64/boot/dts/exynos/exynos7570.dtsi    |   9 +
 2 files changed, 274 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos7570-j4lte.dts b/arch/arm64/boot/dts/exynos/exynos7570-j4lte.dts
index f1554608c..f6a52378a 100644
--- a/arch/arm64/boot/dts/exynos/exynos7570-j4lte.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7570-j4lte.dts
@@ -86,7 +86,7 @@ video-stream@72200000 {
 			no-map;
 		};
 
-		modem@73400000 {
+		modem_rmem: modem@73400000 {
 			reg = <0x0 0x73400000 0x5c00000>;
 			no-map;
 		};
@@ -468,3 +468,267 @@ panel@0 {
 		reset-gpios = <&gpd2 0 GPIO_ACTIVE_HIGH>;
 	};
 };
+
+/*
+ * Shannon modem (SS305AP) over shared memory, for the downstream modem_v1
+ * interface (drivers/misc/modem_v1): the carveout is split into the CP boot
+ * region (0x5800000) and the IPC region (0x400000). mif_pdata is the
+ * downstream modem-ss305ap-pdata.dtsi unchanged but for the interrupts.
+ */
+/ {
+	shmem {
+		compatible = "samsung,exynos-shm_ipc";
+		memory-region = <&modem_rmem>;
+		shmem,ipc_offset = <0x5800000>;
+		shmem,ipc_size = <0x400000>;
+	};
+
+	mif_pdata {
+		compatible = "sec_modem,modem_pdata";
+		status = "okay";
+		/* start = offset of the CP main image in the boot region (from the J4 board dts) */
+		reg = <0x0 0x10000 0x0>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&cp_gpio_j4lte>;
+
+		interrupts = <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 479 IRQ_TYPE_LEVEL_HIGH>;
+
+		/* common pdata */
+		mif,name = "ss305ap";
+		mif,modem_net = <0>;		/* UMTS_NETWORK */
+		mif,modem_type = <10>;		/* SEC_SS310AP */
+		mif,use_handover = <0>;		/* not used */
+		mif,ipc_version = <50>;		/* SIPC 5.0 */
+		mif,link_types = <0x200>;	/* LINKDEV_SHMEM */
+		mif,link_name = "shmem";
+		mif,link_attrs = <0x7C8>;	/* XMIT_BTDLR(0x400) | DUMP_ALIGNED (0x200) | BOOT_ALIGNED (0x100) | MEM_DUMP (0x80) | MEM_BOOT (0x40) | DPRAM_MAGIC (0x08) */
+		mif,num_iodevs = <19>;
+
+		/* mbox pdata */
+		mbx_ap2cp_msg = <0>;
+		mbx_cp2ap_msg = <1>;
+		mbx_ap2cp_united_status = <2>;
+		mbx_cp2ap_united_status = <3>;
+
+		mif,int_ap2cp_msg = <0>;
+		mif,int_ap2cp_status = <2>;
+		mif,int_ap2cp_active = <3>;
+
+		mif,irq_cp2ap_msg = <0>;
+		mif,irq_cp2ap_status = <2>;
+		mif,irq_cp2ap_active = <3>;
+		mif,irq_cp2ap_wake_lock = <8>;
+
+		/* mbox pdata for performance request */
+		mbx_cp2ap_dvfsreq = <4>;
+		mbx_cp2ap_dvfsreq_mif = <6>;
+
+		mif,irq_cp2ap_perf_req_mif = <6>; /* CP2AP_DVFSREQ_MIF */
+
+		/* CP voltage information */
+		mbx_ap2cp_cp_voltage_700 = <5>;
+		mbx_ap2cp_cp_voltage_830 = <7>;
+
+		/* mbox pdata for sbi(status bit info) */
+		sbi_evs_mode_mask = <0x1>;
+		sbi_evs_mode_pos = <7>;
+		sbi_lte_active_mask = <0x1>;
+		sbi_lte_active_pos = <5>;
+		sbi_cp_status_mask = <0xf>;
+		sbi_cp_status_pos = <1>;
+		sbi_pda_active_mask = <0x1>;
+		sbi_pda_active_pos = <5>;
+		sbi_ap_status_mask = <0xf>;
+		sbi_ap_status_pos = <1>;
+
+		sbi_ds_det_mask = <0x3>;
+		sbi_ds_det_pos = <14>;
+		sbi_sys_rev_mask = <0xff>;
+		sbi_sys_rev_pos = <6>;
+		
+		sbi_cp_cpu_freq_asv_mask = <0x7>;
+		sbi_cp_cpu_freq_asv_pos = <19>;
+
+		iodevs {
+			io_device_0 {
+				iod,name = "umts_ipc0";
+				iod,id = <235>;
+				iod,format = <0>;		/* IPC_FMT */
+				iod,io_type = <0>;		/* IODEV_MISC */
+				iod,links = <0x200>;		/* LINKDEV_SHMEM */
+				iod,attrs = <0x2>;		/* ATTR_SIPC5 */
+				iod,app = "RIL";
+			};
+			io_device_1 {
+				iod,name = "umts_ipc1";
+				iod,id = <236>;
+				iod,format = <0>;		/* IPC_FMT */
+				iod,io_type = <0>;		/* IODEV_MISC */
+				iod,links = <0x200>;		/* LINKDEV_SHMEM */
+				iod,attrs = <0x2>;		/* ATTR_SBD_IPC | ATTR_SIPC5 */
+				iod,app = "RIL";
+			};
+			io_device_2 {
+				iod,name = "umts_rfs0";
+				iod,id = <245>;
+				iod,format = <2>;		/* IPC_RFS */
+				iod,io_type = <0>;
+				iod,links = <0x200>;
+				iod,attrs = <0x2>;
+				iod,app = "RFS";
+			};
+			io_device_3 {
+				iod,name = "umts_csd";
+				iod,id = <1>;
+				iod,format = <1>;
+				iod,io_type = <0>;
+				iod,links = <0x200>;
+				iod,attrs = <0x2>;
+				iod,app = "CSVT";
+			};
+			io_device_4 {
+				iod,name = "umts_router";
+				iod,id = <25>;
+				iod,format = <1>;
+				iod,io_type = <0>;
+				iod,links = <0x200>;
+				iod,attrs = <0x2>;
+				iod,app = "Data Router";
+				iod,max_tx_size = <2048>;
+			};
+			io_device_5 {
+				iod,name = "umts_dm0";
+				iod,id = <28>;
+				iod,format = <1>;
+				iod,io_type = <0>;
+				iod,links = <0x200>;
+				iod,attrs = <0x2>;
+				iod,app = "DIAG";
+			};
+			io_device_6 {
+				iod,name = "rmnet0";
+				iod,id = <10>;
+				iod,format = <1>;
+				iod,io_type = <1>;		/* IODEV_NET */
+				iod,links = <0x200>;
+				iod,attrs = <0x2>;
+				iod,app = "NET";
+			};
+			io_device_7 {
+				iod,name = "rmnet1";
+				iod,id = <11>;
+				iod,format = <1>;
+				iod,io_type = <1>;
+				iod,links = <0x200>;
+				iod,attrs = <0x2>;
+				iod,app = "NET";
+						};
+			io_device_8 {
+				iod,name = "rmnet2";
+				iod,id = <12>;
+				iod,format = <1>;
+				iod,io_type = <1>;
+				iod,links = <0x200>;
+				iod,attrs = <0x2>;
+				iod,app = "NET";
+			};
+			io_device_9 {
+				iod,name = "rmnet3";
+				iod,id = <13>;
+				iod,format = <1>;
+				iod,io_type = <1>;
+				iod,links = <0x200>;
+				iod,attrs = <0x2>;
+				iod,app = "NET";
+			};
+			io_device_10 {
+				iod,name = "rmnet4";
+				iod,id = <14>;
+				iod,format = <1>;
+				iod,io_type = <1>;
+				iod,links = <0x200>;
+				iod,attrs = <0x2>;
+			};
+			io_device_11 {
+				iod,name = "rmnet5";
+				iod,id = <15>;
+				iod,format = <1>;
+				iod,io_type = <1>;
+				iod,links = <0x200>;
+				iod,attrs = <0x2>;
+			};
+			io_device_12 {
+				iod,name = "rmnet6";
+				iod,id = <16>;
+				iod,format = <1>;
+				iod,io_type = <1>;
+				iod,links = <0x200>;
+				iod,attrs = <0x2>;
+			};
+			io_device_13 {
+				iod,name = "rmnet7";
+				iod,id = <17>;
+				iod,format = <1>;
+				iod,io_type = <1>;
+				iod,links = <0x200>;
+				iod,attrs = <0x2>;
+			};
+			io_device_14 {
+				iod,name = "multipdp";
+				iod,id = <0>;
+				iod,format = <3>;		/* IPC_MULTI_RAW */
+				iod,io_type = <2>;		/* IODEV_DUMMY */
+				iod,links = <0x200>;
+				iod,attrs = <0x2>;
+				iod,app = "RIL";
+			};
+			io_device_15 {
+				iod,name = "umts_boot0";
+				iod,id = <215>;
+				iod,format = <4>;		/* IPC_BOOT */
+				iod,io_type = <0>;
+				iod,links = <0x200>;
+				iod,attrs = <0x2>;
+				iod,app = "CBD";
+			};
+			io_device_16 {
+				iod,name = "umts_ramdump0";
+				iod,id = <225>;
+				iod,format = <5>;		/* IPC_DUMP */
+				iod,io_type = <0>;
+				iod,links = <0x200>;
+				iod,attrs = <0x202>;		/* ATTR_NO_CHECK_MAXQ | ATTR_SIPC5 */
+				iod,app = "CBD";
+			};
+			io_device_17 {
+				iod,name = "smd4";
+				iod,id = <33>;
+				iod,format = <1>;
+				iod,io_type = <0>;
+				iod,links = <0x200>;
+				iod,attrs = <0x802>;
+				iod,option_region = "kor_skt";
+			};
+			io_device_18 {
+				iod,name = "umts_ciq0";
+				iod,id = <26>;
+				iod,format = <1>;
+				iod,io_type = <0>;
+				iod,links = <0x200>;
+				iod,attrs = <0x802>;
+				iod,option_region = "usa_att";
+			};
+		}; /* end of iodevs */
+	}; /* end of mif_pdata */
+};
+
+&pinctrl_alive {
+	/* a line handed to the CP (downstream exynos7570-pinctrl.dtsi) */
+	cp_gpio_j4lte: cp-gpio-j4lte-pins {
+		samsung,pins = "gpa2-6";
+		samsung,pin-function = <4>;
+		samsung,pin-pud = <0>;
+	};
+};
diff --git a/arch/arm64/boot/dts/exynos/exynos7570.dtsi b/arch/arm64/boot/dts/exynos/exynos7570.dtsi
index b1fea8485..1bdd3e801 100644
--- a/arch/arm64/boot/dts/exynos/exynos7570.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7570.dtsi
@@ -129,6 +129,15 @@ cmu_mif: clock-controller@10460000 {
 			clocks = <&oscclk>;
 		};
 
+		/* AP <-> CP (modem) mailbox; its MIF APB gate is left on by the boot loader */
+		mailbox_cp: mailbox@10500000 {
+			compatible = "samsung,exynos-shd-ipc-mailbox";
+			reg = <0x10500000 0x180>;
+			interrupts = <GIC_SPI 369 IRQ_TYPE_LEVEL_HIGH>;
+			mcu,name = "mcu_ipc_cp";
+			mcu,id = <0>;
+		};
+
 		speedy: speedy@10510000 {
 			compatible = "samsung,exynos7570-speedy";
 			reg = <0x10510000 0x2000>;
