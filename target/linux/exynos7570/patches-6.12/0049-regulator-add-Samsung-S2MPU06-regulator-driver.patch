Subject: [PATCH 049/105] regulator: add Samsung S2MPU06 regulator driver

Signed-off-by: Hendra Manudinata <manoedinata@gmail.com>
(cherry picked from commit e9af4670e27e0a9b49c518857a08851949eebd8d)
---
 .../regulator/samsung,s2mpu06-pmic.yaml       |  63 +++++
 drivers/regulator/Kconfig                     |   7 +
 drivers/regulator/Makefile                    |   1 +
 drivers/regulator/s2mpu06-regulator.c         | 232 ++++++++++++++++++
 4 files changed, 303 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/regulator/samsung,s2mpu06-pmic.yaml
 create mode 100644 drivers/regulator/s2mpu06-regulator.c

diff --git a/Documentation/devicetree/bindings/regulator/samsung,s2mpu06-pmic.yaml b/Documentation/devicetree/bindings/regulator/samsung,s2mpu06-pmic.yaml
new file mode 100644
index 000000000..b35886a61
--- /dev/null
+++ b/Documentation/devicetree/bindings/regulator/samsung,s2mpu06-pmic.yaml
@@ -0,0 +1,63 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/regulator/samsung,s2mpu06-pmic.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S2MPU06 PMIC regulators
+
+maintainers:
+  - Hendra Manudinata <manoedinata@gmail.com>
+
+description:
+  The S2MPU06 is a PMIC with three bucks and twenty LDOs, reached over
+  the SPEEDY bus of the Exynos7570. Regulators not listed in the
+  regulators node are left as the bootloader configured them.
+
+properties:
+  compatible:
+    const: samsung,s2mpu06-pmic
+
+  reg:
+    maxItems: 1
+
+  regulators:
+    type: object
+    description: Regulator nodes named after the rails.
+
+    patternProperties:
+      "^(LDO([1-8]|1[3-9]|2[0-4])|BUCK[1-3])$":
+        type: object
+        $ref: regulator.yaml#
+        unevaluatedProperties: false
+
+    additionalProperties: false
+
+required:
+  - compatible
+  - reg
+  - regulators
+
+additionalProperties: false
+
+examples:
+  - |
+    pmic@0 {
+        compatible = "samsung,s2mpu06-pmic";
+        reg = <0>;
+
+        regulators {
+            BUCK1 {
+                regulator-name = "BUCK1";
+                regulator-min-microvolt = <500000>;
+                regulator-max-microvolt = <1300000>;
+                regulator-always-on;
+            };
+
+            LDO14 {
+                regulator-name = "vemmc";
+                regulator-min-microvolt = <1800000>;
+                regulator-max-microvolt = <3375000>;
+            };
+        };
+    };
diff --git a/drivers/regulator/Kconfig b/drivers/regulator/Kconfig
