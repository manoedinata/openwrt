From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hendra Manudinata <manoedinata@gmail.com>
Date: Sun, 18 Oct 2026 09:13:59 +0700
Subject: [PATCH 52/97] arm64: dts: exynos7570: j4lte: allow high-speed/DDR52
 eMMC

Signed-off-by: Hendra Manudinata <manoedinata@gmail.com>
(cherry picked from commit 22dc71cc33f8ebb56c08b709ad267333e9c3dd24)
---
 arch/arm64/boot/dts/exynos/exynos7570-j4lte.dts | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7570-j4lte.dts b/arch/arm64/boot/dts/exynos/exynos7570-j4lte.dts
index 450c72cb0..29ce0a36a 100644
--- a/arch/arm64/boot/dts/exynos/exynos7570-j4lte.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7570-j4lte.dts
@@ -122,6 +122,7 @@ &mmc0 {
 	samsung,dw-mshc-sdr-timing = <0 2>;
 	samsung,dw-mshc-ddr-timing = <2 4>;
 	non-removable;
+	cap-mmc-highspeed;
 	mmc-ddr-1_8v;
 	no-sd;
 	no-sdio;
