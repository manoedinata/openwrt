From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hendra Manudinata <manoedinata@gmail.com>
Date: Tue, 20 Oct 2026 21:13:32 +0700
Subject: [PATCH 78/92] arm64: dts: exynos7570: give the DECON SysMMU its bus
 and APB clocks

The SysMMU registers sit behind the DISP bus and APB gates. With only
the top bus gate as its clock, runtime suspend accessed it while those
were off, which raised an asynchronous SError from
exynos_sysmmu_suspend().

Signed-off-by: Hendra Manudinata <manoedinata@gmail.com>
(cherry picked from commit d2de5cc666eb926c7766c7822d969e52357e5254)
---
 arch/arm64/boot/dts/exynos/exynos7570.dtsi | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos7570.dtsi b/arch/arm64/boot/dts/exynos/exynos7570.dtsi
index d9146e207..872fc0fce 100644
--- a/arch/arm64/boot/dts/exynos/exynos7570.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7570.dtsi
@@ -392,8 +392,9 @@ sysmmu_decon: iommu@14860000 {
 			interrupts = <GIC_SPI 193 IRQ_TYPE_LEVEL_HIGH>;
 			#iommu-cells = <0>;
 
-			clocks = <&cmu_dispaud CLK_GOUT_DISPAUD_BUS>;
-			clock-names = "sysmmu";
+			clocks = <&cmu_dispaud CLK_GOUT_DISPAUD_BUS_DISP>,
+				 <&cmu_dispaud CLK_GOUT_DISPAUD_APB_DISP>;
+			clock-names = "aclk", "pclk";
 
 			power-domains = <&pd_dispaud>;
 		};
