       - samsung,exynos7570-cmu-fsys
       - samsung,exynos7570-cmu-peri
+      - samsung,exynos7570-cmu-dispaud
 
   clocks:
+    minItems: 1
     items:
       - description: External reference clock (26 MHz)
+      - description: Bus clock of the CMU, a gate in CMU_MIF
+      - description: DECON video clock source, a gate in CMU_MIF
 
   clock-names:
+    minItems: 1
     items:
       - const: oscclk
+      - const: bus
+      - const: decon_vclk
 
   "#clock-cells":
     const: 1
 
+  power-domains:
+    maxItems: 1
+
   reg:
     maxItems: 1
 
@@ -49,6 +59,25 @@ required:
   - "#clock-cells"
   - reg
 
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: samsung,exynos7570-cmu-dispaud
+    then:
+      properties:
