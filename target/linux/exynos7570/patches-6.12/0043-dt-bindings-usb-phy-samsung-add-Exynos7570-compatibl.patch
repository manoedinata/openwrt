From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hendra Manudinata <manoedinata@gmail.com>
Date: Sun, 18 Oct 2026 08:02:32 +0700
Subject: [PATCH 043/108] dt-bindings: usb, phy: samsung: add Exynos7570
 compatibles

The USB 2.0 DRD controller and PHY of the Exynos7570 are the ones of the
Exynos7870, so the new compatibles fall back to the 7870 ones.

Signed-off-by: Hendra Manudinata <manoedinata@gmail.com>
(cherry picked from commit a7abadb0385dcf7de754734c6e1937ff9ca304f3)
---
 .../bindings/phy/samsung,usb3-drd-phy.yaml    | 20 +++++++++++--------
 .../bindings/usb/samsung,exynos-dwc3.yaml     | 18 ++++++++++-------
 2 files changed, 23 insertions(+), 15 deletions(-)

diff --git a/Documentation/devicetree/bindings/phy/samsung,usb3-drd-phy.yaml b/Documentation/devicetree/bindings/phy/samsung,usb3-drd-phy.yaml
index 3b5881e7e..c5954459f 100644
--- a/Documentation/devicetree/bindings/phy/samsung,usb3-drd-phy.yaml
+++ b/Documentation/devicetree/bindings/phy/samsung,usb3-drd-phy.yaml
@@ -24,14 +24,18 @@ description: |
 
 properties:
   compatible:
-    enum:
-      - google,gs101-usb31drd-phy
-      - samsung,exynos5250-usbdrd-phy
-      - samsung,exynos5420-usbdrd-phy
-      - samsung,exynos5433-usbdrd-phy
-      - samsung,exynos7-usbdrd-phy
-      - samsung,exynos7870-usbdrd-phy
-      - samsung,exynos850-usbdrd-phy
+    oneOf:
+      - enum:
+          - google,gs101-usb31drd-phy
+          - samsung,exynos5250-usbdrd-phy
+          - samsung,exynos5420-usbdrd-phy
+          - samsung,exynos5433-usbdrd-phy
+          - samsung,exynos7-usbdrd-phy
+          - samsung,exynos7870-usbdrd-phy
+          - samsung,exynos850-usbdrd-phy
+      - items:
+          - const: samsung,exynos7570-usbdrd-phy
+          - const: samsung,exynos7870-usbdrd-phy
 
   clocks:
     minItems: 2
diff --git a/Documentation/devicetree/bindings/usb/samsung,exynos-dwc3.yaml b/Documentation/devicetree/bindings/usb/samsung,exynos-dwc3.yaml
index 644014b32..9f19e6bc9 100644
--- a/Documentation/devicetree/bindings/usb/samsung,exynos-dwc3.yaml
+++ b/Documentation/devicetree/bindings/usb/samsung,exynos-dwc3.yaml
@@ -11,13 +11,17 @@ maintainers:
 
 properties:
   compatible:
-    enum:
-      - google,gs101-dwusb3
-      - samsung,exynos5250-dwusb3
-      - samsung,exynos5433-dwusb3
-      - samsung,exynos7-dwusb3
-      - samsung,exynos7870-dwusb3
-      - samsung,exynos850-dwusb3
+    oneOf:
+      - enum:
+          - google,gs101-dwusb3
+          - samsung,exynos5250-dwusb3
+          - samsung,exynos5433-dwusb3
+          - samsung,exynos7-dwusb3
+          - samsung,exynos7870-dwusb3
+          - samsung,exynos850-dwusb3
+      - items:
+          - const: samsung,exynos7570-dwusb3
+          - const: samsung,exynos7870-dwusb3
 
   '#address-cells':
     const: 1
