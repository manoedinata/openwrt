From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hendra Manudinata <manoedinata@gmail.com>
Date: Sat, 24 Oct 2026 17:01:53 +0700
Subject: [PATCH 100/104] net: wireless: scsc: apply the regdomain without
 holding rtnl

wiphy_apply_custom_regulatory() takes rtnl itself on current kernels;
on 3.18 it did not. The downstream callers hold rtnl (ndo_open's
slsi_start(), ndo_stop's slsi_stop_net_dev_locked(), the private
ioctls) or the wiphy lock (start_ap), so closing an interface deadlocked
on rtnl: LuCI's scan left rpcd in D state at
  rtnl_lock <- wiphy_apply_custom_regulatory <- slsi_regd_init <-
  slsi_stop_net_dev_locked <- slsi_net_stop <- dev_close
and everything else needing rtnl (iw, addrconf, the regdb worker)
stuck behind it.
- slsi_apply_regd() resets the channel flags and applies the regdomain
  in sdev->device_config from a work item, optionally updating the
  supported channels and disabling channels 12/13 afterwards (the FCC
  ioctl); slsi_start(), slsi_set_country_update_regd(),
  slsi_band_cfg_update() and slsi_set_fcc_channel() use it
- the stop path no longer resets the channel flags and re-applies the
  world regdomain: the flags of the regdomain in force stay
- slsi_regd_init() at attach still applies the world regdomain directly
---
 drivers/net/wireless/scsc/dev.c   | 27 +++++++++++++++++++++++++++
 drivers/net/wireless/scsc/dev.h   |  6 ++++++
 drivers/net/wireless/scsc/ioctl.c | 12 ++++--------
 drivers/net/wireless/scsc/mgt.c   | 24 +++++++++++-------------
 4 files changed, 48 insertions(+), 21 deletions(-)

diff --git a/drivers/net/wireless/scsc/dev.c b/drivers/net/wireless/scsc/dev.c
index f5d7fe0a8..41d5cd824 100755
--- a/drivers/net/wireless/scsc/dev.c
+++ b/drivers/net/wireless/scsc/dev.c
@@ -235,6 +235,31 @@ void slsi_regd_init(struct slsi_dev *sdev)
 	wiphy_apply_custom_regulatory(sdev->wiphy, slsi_world_regdom_custom);
 }
 
+/*
+ * wiphy_apply_custom_regulatory() takes rtnl itself on current kernels, and
+ * the downstream callers hold rtnl (ndo_open/ndo_stop, private ioctls) or
+ * the wiphy lock (cfg80211 ops, which nest inside rtnl). Apply the regdomain
+ * in sdev->device_config from a work item instead, without their locks.
+ */
+static void slsi_regd_work(struct work_struct *work)
+{
+	struct slsi_dev *sdev = container_of(work, struct slsi_dev, regd_work);
+
+	slsi_reset_channel_flags(sdev);
+	wiphy_apply_custom_regulatory(sdev->wiphy, sdev->device_config.domain_info.regdomain);
+	if (READ_ONCE(sdev->regd_work_update_channels))
+		slsi_update_supported_channels_regd_flags(sdev);
+	if (READ_ONCE(sdev->regd_work_disable_ch12_13))
+		slsi_disable_ch12_13(sdev);
+}
+
+void slsi_apply_regd(struct slsi_dev *sdev, bool update_channels, bool disable_ch12_13)
+{
+	WRITE_ONCE(sdev->regd_work_update_channels, update_channels);
+	WRITE_ONCE(sdev->regd_work_disable_ch12_13, disable_ch12_13);
+	schedule_work(&sdev->regd_work);
+}
+
 struct slsi_dev *slsi_dev_attach(struct device *dev, struct scsc_mx *core, struct scsc_service_client *mx_wlan_client)
 {
 	struct slsi_dev *sdev;
@@ -254,6 +279,7 @@ struct slsi_dev *slsi_dev_attach(struct device *dev, struct scsc_mx *core, struc
 	SLSI_MUTEX_INIT(sdev->netdev_remove_mutex);
 	SLSI_MUTEX_INIT(sdev->start_stop_mutex);
 	SLSI_MUTEX_INIT(sdev->device_config_mutex);
+	INIT_WORK(&sdev->regd_work, slsi_regd_work);
 	SLSI_MUTEX_INIT(sdev->logger_mutex);
 
 	sdev->dev = dev;
@@ -486,6 +512,7 @@ void slsi_dev_detach(struct slsi_dev *sdev)
 	SLSI_DBG1(sdev, SLSI_INIT_DEINIT, "Remove Device\n");
 
 	slsi_stop(sdev);
+	cancel_work_sync(&sdev->regd_work);
 
 #ifdef CONFIG_SCSC_WLAN_KIC_OPS
 	wifi_kic_unregister();
diff --git a/drivers/net/wireless/scsc/dev.h b/drivers/net/wireless/scsc/dev.h
index bb088d8a2..f7077e857 100755
--- a/drivers/net/wireless/scsc/dev.h
+++ b/drivers/net/wireless/scsc/dev.h
@@ -1032,6 +1032,10 @@ struct slsi_dev {
 	struct mutex               device_config_mutex;
 #endif
 	struct slsi_dev_config     device_config;
+	/* slsi_apply_regd(): the regdomain is applied from a work item */
+	struct work_struct         regd_work;
+	bool                       regd_work_update_channels;
+	bool                       regd_work_disable_ch12_13;
 
 	struct notifier_block      inetaddr_notifier;
 #ifndef CONFIG_SCSC_WLAN_BLOCK_IPV6
@@ -1187,6 +1191,8 @@ int slsi_dev_get_scan_result_count(void);
 bool slsi_dev_llslogs_supported(void);
 int slsi_dev_nan_supported(struct slsi_dev *sdev);
 void slsi_regd_init(struct slsi_dev *sdev);
+void slsi_apply_regd(struct slsi_dev *sdev, bool update_channels, bool disable_ch12_13);
+void slsi_disable_ch12_13(struct slsi_dev *sdev);
 bool slsi_dev_rtt_supported(void);
 
 static inline u16 slsi_tx_host_tag(struct slsi_dev *sdev, enum slsi_traffic_q tq)
diff --git a/drivers/net/wireless/scsc/ioctl.c b/drivers/net/wireless/scsc/ioctl.c
index e0349f7a3..dbbf39f8c 100755
--- a/drivers/net/wireless/scsc/ioctl.c
+++ b/drivers/net/wireless/scsc/ioctl.c
@@ -2562,7 +2562,7 @@ static int slsi_get_regulatory(struct net_device *dev, char *buf, int buf_len)
 		return -ENOMEM;
 }
 
-static void slsi_disable_ch12_13(struct slsi_dev *sdev)
+void slsi_disable_ch12_13(struct slsi_dev *sdev)
 {
 	struct wiphy *wiphy = sdev->wiphy;
 	struct ieee80211_channel *chan;
@@ -2624,13 +2624,9 @@ static int slsi_set_fcc_channel(struct net_device *dev, char *cmd, int cmd_len)
 		} else {
 			memcpy(sdev->device_config.domain_info.regdomain->alpha2, alpha2, 2);
 			/* Read the regulatory params for the country.*/
-			if (slsi_read_regulatory_rules(sdev, &sdev->device_config.domain_info, alpha2) == 0) {
-				slsi_reset_channel_flags(sdev);
-				wiphy_apply_custom_regulatory(sdev->wiphy, sdev->device_config.domain_info.regdomain);
-				slsi_update_supported_channels_regd_flags(sdev);
-				if (fcc_channel_value == 0 && sdev->device_config.disable_ch12_ch13)
-					slsi_disable_ch12_13(sdev);
-			}
+			if (slsi_read_regulatory_rules(sdev, &sdev->device_config.domain_info, alpha2) == 0)
+				slsi_apply_regd(sdev, true, fcc_channel_value == 0 &&
+						sdev->device_config.disable_ch12_ch13);
 		}
 	}
 	SLSI_MUTEX_UNLOCK(sdev->device_config_mutex);
diff --git a/drivers/net/wireless/scsc/mgt.c b/drivers/net/wireless/scsc/mgt.c
index 00684b178..7f4b908b3 100755
--- a/drivers/net/wireless/scsc/mgt.c
+++ b/drivers/net/wireless/scsc/mgt.c
@@ -630,10 +630,8 @@ int slsi_start(struct slsi_dev *sdev)
 			memcpy(sdev->device_config.domain_info.regdomain->alpha2, alpha2, 2);
 
 			/* Read the regulatory params for the country*/
-			if (slsi_read_regulatory_rules(sdev, &sdev->device_config.domain_info, alpha2) == 0) {
-				slsi_reset_channel_flags(sdev);
-				wiphy_apply_custom_regulatory(sdev->wiphy, sdev->device_config.domain_info.regdomain);
-			}
+			if (slsi_read_regulatory_rules(sdev, &sdev->device_config.domain_info, alpha2) == 0)
+				slsi_apply_regd(sdev, false, false);
 		}
 	/* Do nothing for unifiDefaultCountry == world_domain */
 
@@ -809,8 +807,12 @@ static void slsi_stop_chip(struct slsi_dev *sdev)
 		kfree(sdev->collect_mib.file[i].data);
 #endif
 
-	slsi_reset_channel_flags(sdev);
-	slsi_regd_init(sdev);
+	/*
+	 * Downstream reset the channel flags and re-applied the world regdomain
+	 * here. This runs with rtnl held (ndo_stop, del_virtual_intf) and
+	 * wiphy_apply_custom_regulatory() takes rtnl itself on current kernels:
+	 * a deadlock. Keep the flags of the regdomain in force instead.
+	 */
 	sdev->device_state = SLSI_DEVICE_STATE_STOPPING;
 
 	slsi_sm_wlan_service_stop(sdev);
@@ -2873,8 +2875,7 @@ static void slsi_band_cfg_update(struct slsi_dev *sdev, int band)
 	default:
 		break;
 	}
-	wiphy_apply_custom_regulatory(sdev->wiphy, sdev->device_config.domain_info.regdomain);
-	slsi_update_supported_channels_regd_flags(sdev);
+	slsi_apply_regd(sdev, true, false);
 }
 
 int slsi_band_update(struct slsi_dev *sdev, int band)
@@ -5290,11 +5291,8 @@ int slsi_set_country_update_regd(struct slsi_dev *sdev, const char *alpha2_code,
 	}
 
 	/* Read the regulatory params for the country */
-	if (slsi_read_regulatory_rules(sdev, &sdev->device_config.domain_info, alpha2) == 0) {
-		slsi_reset_channel_flags(sdev);
-		wiphy_apply_custom_regulatory(sdev->wiphy, sdev->device_config.domain_info.regdomain);
-		slsi_update_supported_channels_regd_flags(sdev);
-	}
+	if (slsi_read_regulatory_rules(sdev, &sdev->device_config.domain_info, alpha2) == 0)
+		slsi_apply_regd(sdev, true, false);
 
 exit:
 	SLSI_MUTEX_UNLOCK(sdev->device_config_mutex);
