From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hendra Manudinata <manoedinata@gmail.com>
Date: Sun, 18 Oct 2026 13:07:53 +0700
Subject: [PATCH 062/106] arm64: dts: exynos7570: j4lte: add the SM5504 MUIC,
 charger follows the cable

The MUIC sits on the I2C_MUIC bus. The charger takes its input and charge
current from the cable it reports: 500/500 mA for a PC port and 1000/1200 mA
for a wall charger, as in the J4's cable table.

Signed-off-by: Hendra Manudinata <manoedinata@gmail.com>
(cherry picked from commit bb507df6a9d20406183f3af4ca163c4429f827f9)
---
 .../bindings/i2c/samsung,s3c2410-i2c.yaml     |  1 +
 .../regulator/samsung,s2mpu06-pmic.yaml       |  7 ++
 .../boot/dts/exynos/exynos7570-j4lte.dts      | 14 ++++
 .../boot/dts/exynos/exynos7570-pinctrl.dtsi   | 14 ++++
 arch/arm64/boot/dts/exynos/exynos7570.dtsi    | 17 +++++
 drivers/power/supply/s2mpu06_charger.c        | 74 +++++++++++++++++++
 6 files changed, 127 insertions(+)

diff --git a/Documentation/devicetree/bindings/i2c/samsung,s3c2410-i2c.yaml b/Documentation/devicetree/bindings/i2c/samsung,s3c2410-i2c.yaml
index bbc568485..dbc32fc74 100644
--- a/Documentation/devicetree/bindings/i2c/samsung,s3c2410-i2c.yaml
+++ b/Documentation/devicetree/bindings/i2c/samsung,s3c2410-i2c.yaml
@@ -22,6 +22,7 @@ properties:
           - samsung,exynos5-sata-phy-i2c
       - items:
           - enum:
+              - samsung,exynos7570-i2c
               - samsung,exynos7885-i2c
               - samsung,exynos850-i2c
           - const: samsung,s3c2440-i2c
diff --git a/Documentation/devicetree/bindings/regulator/samsung,s2mpu06-pmic.yaml b/Documentation/devicetree/bindings/regulator/samsung,s2mpu06-pmic.yaml
index 46f12ebde..3a3941c65 100644
--- a/Documentation/devicetree/bindings/regulator/samsung,s2mpu06-pmic.yaml
+++ b/Documentation/devicetree/bindings/regulator/samsung,s2mpu06-pmic.yaml
@@ -29,6 +29,13 @@ properties:
     $ref: /schemas/types.yaml#/definitions/phandle
     description: Battery described by a simple-battery node, used by the fuel gauge.
 
+  extcon:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    maxItems: 1
+    description:
+      MUIC whose cable detection sets the input and charge current of the
+      charger.
+
   io-channels:
     maxItems: 1
     description: ADC channel the battery thermistor is wired to.
diff --git a/arch/arm64/boot/dts/exynos/exynos7570-j4lte.dts b/arch/arm64/boot/dts/exynos/exynos7570-j4lte.dts
index 2c32360b8..4935bb027 100644
--- a/arch/arm64/boot/dts/exynos/exynos7570-j4lte.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7570-j4lte.dts
@@ -164,6 +164,7 @@ pmic@0 {
 		pinctrl-0 = <&pmic_irq>;
 
 		monitored-battery = <&battery>;
+		extcon = <&muic>;
 
 		/* battery NTC on the AP's ADC channel 1 */
 		io-channels = <&adc 1>;
@@ -415,3 +416,16 @@ ldo24_reg: LDO24 {
 		};
 	};
 };
+
+&i2c_muic {
+	status = "okay";
+
+	muic: muic@14 {
+		compatible = "siliconmitus,sm5504-muic";
+		reg = <0x14>;
+		interrupt-parent = <&gpa1>;
+		interrupts = <1 IRQ_TYPE_EDGE_FALLING>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&muic_irq>;
+	};
+};
diff --git a/arch/arm64/boot/dts/exynos/exynos7570-pinctrl.dtsi b/arch/arm64/boot/dts/exynos/exynos7570-pinctrl.dtsi
index 9cf517abf..f056216fb 100644
--- a/arch/arm64/boot/dts/exynos/exynos7570-pinctrl.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7570-pinctrl.dtsi
@@ -123,6 +123,12 @@ gpr4: gpr4-gpio-bank {
 };
 
 &pinctrl_alive {
+	muic_irq: muic-irq-pins {
+		samsung,pins = "gpa1-1";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+
 	pmic_irq: pmic-irq-pins {
 		samsung,pins = "gpa0-5";
 		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
@@ -241,3 +247,11 @@ speedy_bus: speedy-bus-pins {
 		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
 	};
 };
+
+&pinctrl_top {
+	i2c_muic_bus: i2c-muic-bus-pins {
+		samsung,pins = "gpc1-3", "gpc1-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+	};
+};
diff --git a/arch/arm64/boot/dts/exynos/exynos7570.dtsi b/arch/arm64/boot/dts/exynos/exynos7570.dtsi
index 5d9d37821..4b848cee9 100644
--- a/arch/arm64/boot/dts/exynos/exynos7570.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7570.dtsi
@@ -161,6 +161,23 @@ adc: adc@10550000 {
 			#io-channel-cells = <1>;
 		};
 
+		i2c_muic: i2c@13880000 {
+			compatible = "samsung,exynos7570-i2c", "samsung,s3c2440-i2c";
+			reg = <0x13880000 0x100>;
+			interrupts = <GIC_SPI 429 IRQ_TYPE_LEVEL_HIGH>;
+
+			pinctrl-names = "default";
+			pinctrl-0 = <&i2c_muic_bus>;
+
+			clock-names = "i2c";
+			clocks = <&cmu_peri CLK_GOUT_PERI_I2C_MUIC_PCLK>;
+
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			status = "disabled";
+		};
+
 		pinctrl_mif: pinctrl@10530000 {
 			compatible = "samsung,exynos7570-pinctrl";
 			reg = <0x10530000 0x1000>;
diff --git a/drivers/power/supply/s2mpu06_charger.c b/drivers/power/supply/s2mpu06_charger.c
index eb2fae318..daa53f6ad 100644
--- a/drivers/power/supply/s2mpu06_charger.c
+++ b/drivers/power/supply/s2mpu06_charger.c
@@ -13,6 +13,7 @@
 
 #include <linux/bitfield.h>
 #include <linux/bits.h>
+#include <linux/extcon.h>
 #include <linux/math.h>
 #include <linux/interrupt.h>
 #include <linux/mfd/samsung/s2mpu06.h>
@@ -90,6 +91,15 @@ enum s2mpu06_temp_state {
 	S2MPU06_TEMP_HOT_BLOCK,
 };
 
+/*
+ * Input and charge current per cable type, from the J4's cable table: a PC port
+ * gives 500 mA, a wall charger (the vendor's "TA") 1 A in and 1.2 A to the cell.
+ */
+#define S2MPU06_USB_IIN_UA		500000
+#define S2MPU06_USB_ICHG_UA		500000
+#define S2MPU06_DCP_IIN_UA		1000000
+#define S2MPU06_DCP_ICHG_UA		1200000
+
 struct s2mpu06_charger {
 	struct device *dev;
 	struct s2mpu06 *s2m;
@@ -97,6 +107,10 @@ struct s2mpu06_charger {
 	struct delayed_work work;
 	struct mutex lock;	/* requested limits and the thermal state */
 
+	struct extcon_dev *edev;
+	struct notifier_block cable_nb;
+	struct work_struct cable_work;
+
 	/* what userspace (or the bootloader) asked for, in register units */
 	unsigned int req_ichg_sel;
 	unsigned int req_iin_sel;
@@ -501,6 +515,41 @@ static irqreturn_t s2mpu06_charger_acok_irq(int irq, void *data)
 	return IRQ_HANDLED;
 }
 
+/* the cable the MUIC reports decides how much current may be drawn and given to the cell */
+static void s2mpu06_charger_cable_work(struct work_struct *work)
+{
+	struct s2mpu06_charger *chg = container_of(work, struct s2mpu06_charger, cable_work);
+	int iin = S2MPU06_USB_IIN_UA, ichg = S2MPU06_USB_ICHG_UA;
+
+	if (extcon_get_state(chg->edev, EXTCON_CHG_USB_DCP) > 0) {
+		iin = S2MPU06_DCP_IIN_UA;
+		ichg = S2MPU06_DCP_ICHG_UA;
+	}
+
+	mutex_lock(&chg->lock);
+	chg->req_iin_sel = clamp(iin / S2MPU06_IIN_STEP_UA, S2MPU06_IIN_MIN_SEL, S2MPU06_IIN_MAX_SEL);
+	chg->req_ichg_sel = s2mpu06_ichg_to_sel(ichg);
+	if (!s2mpu06_charger_apply_limits(chg))
+		dev_info(chg->dev, "cable: input %d mA, charge %d mA\n", iin / 1000, ichg / 1000);
+	mutex_unlock(&chg->lock);
+
+	power_supply_changed(chg->psy);
+}
+
+static int s2mpu06_charger_cable_event(struct notifier_block *nb, unsigned long state, void *data)
+{
+	struct s2mpu06_charger *chg = container_of(nb, struct s2mpu06_charger, cable_nb);
+
+	schedule_work(&chg->cable_work);
+
+	return NOTIFY_OK;
+}
+
+static void s2mpu06_charger_cancel_cable(void *data)
+{
+	cancel_work_sync(data);
+}
+
 static void s2mpu06_charger_cancel_work(void *data)
 {
 	cancel_delayed_work_sync(data);
@@ -555,6 +604,31 @@ static int s2mpu06_charger_probe(struct platform_device *pdev)
 			return dev_err_probe(dev, ret, "cannot request the AC OK irq\n");
 	}
 
+	/* optional: without a MUIC the limits stay as they were left */
+	chg->edev = extcon_get_edev_by_phandle(dev->parent, 0);
+	if (IS_ERR(chg->edev)) {
+		ret = PTR_ERR(chg->edev);
+		chg->edev = NULL;
+		if (ret == -EPROBE_DEFER)
+			return ret;
+	}
+	if (chg->edev) {
+		INIT_WORK(&chg->cable_work, s2mpu06_charger_cable_work);
+		ret = devm_add_action_or_reset(dev, s2mpu06_charger_cancel_cable, &chg->cable_work);
+		if (ret)
+			return ret;
+
+		chg->cable_nb.notifier_call = s2mpu06_charger_cable_event;
+		for (i = 0; i < 2; i++) {
+			ret = devm_extcon_register_notifier(dev, chg->edev,
+							    i ? EXTCON_CHG_USB_DCP : EXTCON_CHG_USB_SDP,
+							    &chg->cable_nb);
+			if (ret)
+				return dev_err_probe(dev, ret, "cannot watch the cable\n");
+		}
+		schedule_work(&chg->cable_work);
+	}
+
 	regmap_read(chg->s2m->chg, S2MPU06_CHG_CTRL12, &ctrl12);
 	dev_info(dev, "charger CTRL12 %#x (watchdog %s)\n", ctrl12,
 		 (ctrl12 & S2MPU06_CHG_CTRL12_WDT_EN) ? "armed" : "off");
