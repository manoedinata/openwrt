From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hendra Manudinata <manoedinata@gmail.com>
Date: Sat, 24 Oct 2026 16:07:13 +0700
Subject: [PATCH 097/107] misc: samsung: scsc: hide the SCSC options without
 SCSC_CORE

The FW/tool location, platform, build type and dual FEM options had no
dependency, so a config without SCSC_CORE still got asked for them
(syncconfig stopped at "SCSC FW location (SCSC_CORE_FW_LOCATION)
[/system/etc/wifi] (NEW)" in the OpenWrt kernel build).
---
 drivers/misc/samsung/scsc/Kconfig | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/misc/samsung/scsc/Kconfig b/drivers/misc/samsung/scsc/Kconfig
index ec368cfe7..7c6b9b6f0 100644
--- a/drivers/misc/samsung/scsc/Kconfig
+++ b/drivers/misc/samsung/scsc/Kconfig
@@ -9,24 +9,28 @@ config SCSC_CORE
 
 config SCSC_CORE_FW_LOCATION
 	string "SCSC FW location"
+	depends on SCSC_CORE
 	default "/system/etc/wifi"
 	help
 	  Select the FW location, when CONFIG_SCSC_CORE_FW_LOCATION_AUTO=n
 
 config SCSC_CORE_FW_LOCATION_AUTO
 	bool "SCSC FW location auto select"
+	depends on SCSC_CORE
 	default y
 	help
 	  Select the FW location (Android N/O) automatically
 
 config SCSC_CORE_TOOL_LOCATION
 	string "SCSC tool location"
+	depends on SCSC_CORE
 	default "/system/bin"
 	help
 	  Select the moredump tool location, when CONFIG_SCSC_CORE_FW_LOCATION_AUTO=n
 
 config SCSC_WLBT_CONFIG_PLATFORM
 	string "SCSC WLBT PLATFORM"
+	depends on SCSC_CORE
 	default ""
 	help
 	  Select the platform, e.g. lassen_smdk
@@ -118,6 +122,7 @@ config SCSC_GPR4_CON_DEBUG
 
 config SCSC_BUILD_TYPE
        string "Type of Kernel Build"
+       depends on SCSC_CORE
        help
          Type of Kernel Build: User, User Debug, Engineering
 
@@ -145,6 +150,7 @@ config SCSC_LOG_COLLECTION
 
 config SCSC_MX150_EXT_DUAL_FEM_
 	bool "Support MX150 boards with dual external WLBT front-end"
+	depends on SCSC_CORE
 	default n
 	help
 	Some boards have dual-external front end module for WLAN/BT
