+# ----------------------------------------------------------------------------
+# Building for cfg802.11
+# ----------------------------------------------------------------------------
+$(CONFIG_SCSC_WLAN_MODULE)-y += ../cfg80211_ops.o
+$(CONFIG_SCSC_WLAN_MODULE)-y += ../mlme.o
+$(CONFIG_SCSC_WLAN_MODULE)-y += ../netif.o
+$(CONFIG_SCSC_WLAN_MODULE)-y += ../rx.o
