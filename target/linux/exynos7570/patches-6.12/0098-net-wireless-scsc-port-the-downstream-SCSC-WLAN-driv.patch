+};
+
+struct slsi_mlme_pkt_filter_elem {
+	u8                            header[SLSI_PKT_FILTER_ELEM_HDR_LEN];
+	u8                            num_pattern_desc;
+	struct slsi_mlme_pattern_desc pattern_desc[SLSI_MAX_PATTERN_DESC];
+};
