+	do { \
+		if (hip4_sampler_sample_int) { \
+			hip4_sampler_update_record(minor, HIP4_SAMPLER_INT, 0, 0, 0); \
+		} \
+	} while (0)
+#define SCSC_HIP4_SAMPLER_INT_OUT(minor) \
