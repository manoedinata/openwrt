+#define P80211_OUI_LEN		3
+
+struct ieee80211_snap_hdr {
+	u8 dsap;                /* always 0xAA */
+	u8 ssap;                /* always 0xAA */
+	u8 ctrl;                /* always 0x03 */
+	u8 oui[P80211_OUI_LEN]; /* organizational universal id */
+} __packed;
