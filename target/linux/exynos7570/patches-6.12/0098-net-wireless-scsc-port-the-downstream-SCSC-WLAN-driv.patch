+/* Downstream poked qdisc->q and gso_skb directly; go through the qdisc ops */
+static void slsi_qdisc_enqueue(struct sk_buff *skb, struct Qdisc *qd)
+{
+	struct sk_buff *to_free = NULL;
+
+	qd->enqueue(skb, qd, &to_free);
+	kfree_skb_list(to_free);
+}
