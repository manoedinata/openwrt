+		return -EINVAL;
+	}
+
+	memcpy(alpha2_code, ioctl_args->args[0], 2);
+	alpha2_code[2] = ' '; /* set 3rd byte of countrycode to ASCII space */
+
+	status = slsi_set_country_update_regd(sdev, alpha2_code, SLSI_COUNTRY_CODE_LEN);
+
+	kfree(ioctl_args);
+	return status;
+}
