+#define SLSI_EC(func) \
+	do { \
+		int _err = (func); \
+		if (_err != 0) { \
+			SLSI_ERR_NODEV("e=%d\n", _err); \
+			return; \
+		} \
+	} while (0)
+
+#define SLSI_EC_GOTO(func, err, label) \
+	do { \
+		(err) = func; \
+		if ((err) != 0) { \
+			WARN_ON(1); \
+			SLSI_ERR(sdev, "fail at line:%d\n", __LINE__); \
+			goto label; \
+		} \
+	} while (0)
