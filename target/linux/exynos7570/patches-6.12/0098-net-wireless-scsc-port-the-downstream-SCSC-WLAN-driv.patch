+static const char *slsi_procfs_vif_type_to_str(u16 type)
+{
+	switch (type) {
+	case FAPI_VIFTYPE_STATION:
+		return "STATION";
+	case FAPI_VIFTYPE_AP:
+		return "AP";
+	case FAPI_VIFTYPE_UNSYNCHRONISED:
+		return "UNSYNCH";
+	default:
+		return "?";
+	}
+}
