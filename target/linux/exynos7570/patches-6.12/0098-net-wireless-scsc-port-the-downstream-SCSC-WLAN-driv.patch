+static inline int slsi_str_to_int(char *str, int *result)
+{
+	int i = 0;
+	int sign = 1;
+	int err = 0;
+	long long int res = 0;
+	int digit = 0;
+
+	if (!str)
+		return 0;
+	if (*str == '-') {
+		sign = -1;
+		++str;
+	} else if (*str == '+') {
+		sign = 1;
+		++str;
+	}
+
+	*result = 0;
+	if ((str[i] >= '0') && (str[i] <= '9')) {
+		while (str[i] >= '0' && str[i] <= '9') {
+			if (res > INT_MAX / 10) {
+				err = 1;
+				break;
+			}
+			res *= 10;
+			digit = str[i] - '0';
+
+			if (res > INT_MAX - digit) {
+				if (sign == -1) {
+					res += digit;
+					if (-(res) >= INT_MIN) {
+						break;
+					} else {
+						err = 1;
+						break;
+					}
+				} else {
+					err = 1;
+					break;
+				}
+			}
+			res += digit;
+			i++;
+		}
+
+		if (!err)
+			*result = ((sign == -1) ? -(res) : res);
+		else
+			return 0;
+	}
+	return i;
+}
