+/* Cookie generation and assignment for user space ROC and mgmt_tx request from supplicant */
+static inline void slsi_assign_cookie_id(u64 *cookie, u64 *counter)
+{
+	(*cookie) = ++(*counter);
+	if ((*cookie) == 0)
