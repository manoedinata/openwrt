+		{ "QosNull",             NULL },
+		{ "Reserved",            NULL },
+		{ "QosCF-Poll",          NULL },
+		{ "QosCF-Ack+Poll",      NULL }
+	},
+	{
+		{ "Reserved",            NULL },
