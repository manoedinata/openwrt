+		return -EINVAL;
+	}
+
+	slsi_band_update(sdev, band);
+	kfree(ioctl_args);
+	/* Convert to correct Mib value (intra_band:1, all_band:2) */
+	return slsi_set_mib_roam(sdev, NULL, SLSI_PSID_UNIFI_ROAM_SCAN_BAND, (band == SLSI_FREQ_BAND_AUTO) ? 2 : 1);
+}
