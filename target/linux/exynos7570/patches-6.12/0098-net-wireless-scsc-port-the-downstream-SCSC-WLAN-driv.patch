+#define HIP4_SAMPLER_MBULK              0xaa
+#define HIP4_SAMPLER_QFULL              0xbb
+#define HIP4_SAMPLER_MFULL              0xcc
+#define HIP4_SAMPLER_INT                0xdd
+#define HIP4_SAMPLER_INT_OUT            0xee
+#define HIP4_SAMPLER_RESET              0xff
