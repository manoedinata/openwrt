+		return;
+	}
+
+	SLSI_NET_DBG1(dev, SLSI_MLME, "mlme_connect_resp(vif:%u)\n", ndev_vif->ifnum);
+	req = fapi_alloc(mlme_connect_res, MLME_CONNECT_RES, ndev_vif->ifnum, 0);
+	if (!req)
+		return;
+
+	cfm = slsi_mlme_req_no_cfm(sdev, dev, req);
