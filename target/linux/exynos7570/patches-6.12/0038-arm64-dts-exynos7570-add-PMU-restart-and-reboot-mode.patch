From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hendra Manudinata <manoedinata@gmail.com>
Date: Sun, 18 Oct 2026 07:09:46 +0700
Subject: [PATCH 38/92] arm64: dts: exynos7570: add PMU, restart and
 reboot-mode, ramoops ECC

Add the PMU system controller with the generic Exynos syscon restart and
poweroff nodes (SWRESET 0x0400, PS_HOLD_CONTROL 0x330c, same as the other
Exynos7 SoCs) and Samsung's INFORM3 reboot-mode magics, so the board can
restart itself and honour 'reboot recovery/download'. PSCI on this firmware
only provides the v0.1 function IDs and thus no SYSTEM_RESET.

Enable Reed-Solomon ECC on the ramoops region: a hard reset leaves bit flips
in the preserved log. Document samsung,exynos7570-pmu.

Signed-off-by: Hendra Manudinata <manoedinata@gmail.com>
(cherry picked from commit 5dcc0e9352ec574bfedb605c2910f588a9787f9f)
---
 .../bindings/soc/samsung/exynos-pmu.yaml        |  1 +
 arch/arm64/boot/dts/exynos/exynos7570-j4lte.dts |  3 ++-
 arch/arm64/boot/dts/exynos/exynos7570.dtsi      | 17 +++++++++++++++++
 3 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/soc/samsung/exynos-pmu.yaml b/Documentation/devicetree/bindings/soc/samsung/exynos-pmu.yaml
index 0927b07af..c28585c0d 100644
--- a/Documentation/devicetree/bindings/soc/samsung/exynos-pmu.yaml
+++ b/Documentation/devicetree/bindings/soc/samsung/exynos-pmu.yaml
@@ -52,6 +52,7 @@ properties:
           - const: syscon
       - items:
           - enum:
+              - samsung,exynos7570-pmu
               - samsung,exynos7870-pmu
               - samsung,exynos7885-pmu
               - samsung,exynosautov9-pmu
diff --git a/arch/arm64/boot/dts/exynos/exynos7570-j4lte.dts b/arch/arm64/boot/dts/exynos/exynos7570-j4lte.dts
index 39dc1f450..843e0e39a 100644
--- a/arch/arm64/boot/dts/exynos/exynos7570-j4lte.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7570-j4lte.dts
@@ -18,7 +18,7 @@ chosen {
 		#size-cells = <1>;
 		ranges;
 
-		bootargs = "console=tty0 ignore_loglevel clk_ignore_unused";
+		bootargs = "console=tty0 ignore_loglevel clk_ignore_unused j4.autoreboot=45";
 
 		/* Set up by the bootloader (uniLoader), scanned out by DECON */
 		framebuffer0: framebuffer@67000000 {
@@ -49,6 +49,7 @@ ramoops@7e100000 {
 			record-size = <0x20000>;
 			console-size = <0x100000>;
 			pmsg-size = <0x20000>;
+			ecc-size = <16>;
 			no-map;
 		};
 
diff --git a/arch/arm64/boot/dts/exynos/exynos7570.dtsi b/arch/arm64/boot/dts/exynos/exynos7570.dtsi
index ea4a15b64..c2cb68016 100644
--- a/arch/arm64/boot/dts/exynos/exynos7570.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7570.dtsi
@@ -138,6 +138,21 @@ cmu_fsys: clock-controller@13730000 {
 			clock-names = "oscclk";
 			clocks = <&oscclk>;
 		};
+
+		pmu_system_controller: system-controller@11c80000 {
+			compatible = "samsung,exynos7570-pmu",
+				     "samsung,exynos7-pmu", "syscon";
+			reg = <0x11c80000 0x10000>;
+
+			reboot-mode {
+				compatible = "syscon-reboot-mode";
+				offset = <0x080c>;
+				mode-normal = <0x12345670>;
+				mode-bootloader = <0x1234567d>;
+				mode-download = <0x12345671>;
+				mode-recovery = <0x12345674>;
+			};
+		};
 	};
 
 	timer {
@@ -153,3 +168,5 @@ timer {
 		clock-frequency = <26000000>;
 	};
 };
+
+#include "arm/samsung/exynos-syscon-restart.dtsi"
