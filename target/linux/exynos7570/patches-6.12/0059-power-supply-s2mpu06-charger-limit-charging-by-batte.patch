-			      (reg - S2MPU06_ICHG_BASE_SEL) * S2MPU06_ICHG_STEP_UA;
+		val->intval = s2mpu06_sel_to_ichg(reg & S2MPU06_CHG_CTRL10_MASK);
 		return 0;
